    {
      "parameters": {
        "jsCode": "const reqBody = $('Check Bearer Auth').first().json.body || {};\nconst sessionId = String(reqBody.sessionId || 'default-session');\nconst agentOutput = $json.output || $json.text || $json.response || '';\nconst steps = Array.isArray($json.intermediateSteps) ? $json.intermediateSteps : [];\n\nconst usedToolsSet = new Set();\nconst sources = [];\nconst seenSources = new Set();\n\nfunction pushSource(item) {\n  if (!item || typeof item !== 'object') return;\n  const meta = item.metadata || item.payload || item;\n  const filename = meta.filename || meta.source || item.filename || '';\n  const category = meta.category || item.category || '';\n  const doc_type = meta.doc_type || item.doc_type || '';\n  const snippetRaw = item.pageContent || item.text || item.snippet || meta.text || '';\n  const snippet = String(snippetRaw).trim().slice(0, 280);\n  if (!filename && !snippet) return;\n  const key = `${filename}|${snippet.slice(0, 80)}`;\n  if (seenSources.has(key)) return;\n  seenSources.add(key);\n  sources.push({\n    filename: String(filename || 'unknown'),\n    category: String(category || ''),\n    doc_type: String(doc_type || ''),\n    snippet\n  });\n}\n\nfor (const step of steps) {\n  const toolName = step && step.action && step.action.tool ? String(step.action.tool) : '';\n  if (toolName) usedToolsSet.add(toolName);\n\n  const obs = step ? step.observation : null;\n  if (!obs) continue;\n\n  let parsed = obs;\n  if (typeof obs === 'string') {\n    try {\n      parsed = JSON.parse(obs);\n    } catch (_) {\n      parsed = null;\n    }\n  }\n  if (Array.isArray(parsed)) {\n    for (const entry of parsed) pushSource(entry);\n  } else if (parsed && typeof parsed === 'object') {\n    if (Array.isArray(parsed.documents)) {\n      for (const doc of parsed.documents) pushSource(doc);\n    } else if (Array.isArray(parsed.results)) {\n      for (const doc of parsed.results) pushSource(doc);\n    } else {\n      pushSource(parsed);\n    }\n  }\n}\n\nreturn [{\n  json: {\n    status: 'ok',\n    answer: String(agentOutput).trim(),\n    used_tools: Array.from(usedToolsSet),\n    sources,\n    sessionId\n  }\n}];"
      },
