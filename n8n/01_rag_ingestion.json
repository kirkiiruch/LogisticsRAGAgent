      "name": "Respond Unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first();\nconst payload = raw.json || {};\nconst body = (payload.body && typeof payload.body === 'object') ? payload.body : payload;\n\nconst categoryMap = {\n  faktura: 'invoice',\n  pokladnicny_doklad: 'receipt',\n  zmluva: 'contract',\n  smernica: 'guideline'\n};\n\nconst category = String(body.category || 'smernica').trim().toLowerCase();\nconst doc_type = String(body.doc_type || categoryMap[category] || category).trim().toLowerCase();\nconst uploaded_at = String(body.uploaded_at || new Date().toISOString());\n\nif (typeof body.text === 'string' && body.text.trim().length > 0) {\n  const filename = String(body.filename || 'inline_document.txt').trim();\n  return [{\n    json: {\n      source_mode: 'json',\n      text: body.text.trim(),\n      filename,\n      category,\n      doc_type,\n      uploaded_at\n    }\n  }];\n}\n\nconst bin = raw.binary || {};\nconst binKey = bin.file ? 'file' : (bin.data ? 'data' : Object.keys(bin)[0]);\nif (!binKey || !bin[binKey]) {\n  return [{\n    json: {\n      source_mode: 'error',\n      error_message: 'Missing binary file (field file/data) or JSON text field',\n      filename: String(body.filename || 'unknown'),\n      category,\n      doc_type,\n      uploaded_at\n    }\n  }];\n}\n\nconst binObj = bin[binKey];\nconst filename = String(body.filename || binObj.fileName || 'uploaded_document.txt').trim();\nconst lowerName = filename.toLowerCase();\nconst mime = String(binObj.mimeType || '').toLowerCase();\n\nlet source_mode = 'txt';\nif (lowerName.endsWith('.pdf') || mime.includes('pdf')) {\n  source_mode = 'pdf';\n} else if (lowerName.endsWith('.csv') || mime.includes('csv')) {\n  source_mode = 'csv';\n} else if (lowerName.endsWith('.docx') || mime.includes('wordprocessingml')) {\n  source_mode = 'docx';\n} else if (lowerName.endsWith('.txt') || mime.startsWith('text/')) {\n  source_mode = 'txt';\n} else {\n  source_mode = 'error';\n}\n\nreturn [{\n  json: {\n    source_mode,\n    filename,\n    category,\n    doc_type,\n    uploaded_at\n  },\n  binary: {\n    data: binObj\n  }\n}];"
      },
