    {
      "parameters": {
        "jsCode": "const expected = ($env.WEBHOOK_BEARER_TOKEN || '').trim();\nconst headers = $json.headers || {};\nconst authHeader = headers.authorization || headers.Authorization || '';\nconst authorized = !expected || authHeader === ('Bearer ' + expected);\nreturn [{\n  json: {\n    ...$json,\n    authorized\n  },\n  binary: $input.first().binary\n}];"
      },
