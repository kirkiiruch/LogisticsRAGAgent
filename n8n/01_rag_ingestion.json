    {
      "parameters": {
        "jsCode": "const zlib = require('zlib');\nconst meta = $('Prepare Input').first().json;\nconst buf = await this.helpers.getBinaryDataBuffer(0, 'data');\n\nfunction extractDocxXml(buffer) {\n  let eocdOffset = -1;\n  for (let i = buffer.length - 22; i >= Math.max(0, buffer.length - 65557); i--) {\n    if (buffer.readUInt32LE(i) === 0x06054b50) {\n      eocdOffset = i;\n      break;\n    }\n  }\n  if (eocdOffset === -1) {\n    throw new Error('Invalid DOCX archive: EOCD not found');\n  }\n  const cdSize = buffer.readUInt32LE(eocdOffset + 12);\n  const cdOffset = buffer.readUInt32LE(eocdOffset + 16);\n  let pos = cdOffset;\n  while (pos < cdOffset + cdSize) {\n    if (buffer.readUInt32LE(pos) !== 0x02014b50) break;\n    const compMethod = buffer.readUInt16LE(pos + 10);\n    const compSize = buffer.readUInt32LE(pos + 20);\n    const nameLen = buffer.readUInt16LE(pos + 28);\n    const extraLen = buffer.readUInt16LE(pos + 30);\n    const commentLen = buffer.readUInt16LE(pos + 32);\n    const localOffset = buffer.readUInt32LE(pos + 42);\n    const entryName = buffer.toString('utf8', pos + 46, pos + 46 + nameLen);\n    if (entryName === 'word/document.xml') {\n      const lfhNameLen = buffer.readUInt16LE(localOffset + 26);\n      const lfhExtraLen = buffer.readUInt16LE(localOffset + 28);\n      const dataStart = localOffset + 30 + lfhNameLen + lfhExtraLen;\n      const compressed = buffer.subarray(dataStart, dataStart + compSize);\n      const xmlBuf = compMethod === 0 ? compressed : zlib.inflateRawSync(compressed);\n      return xmlBuf.toString('utf8');\n    }\n    pos += 46 + nameLen + extraLen + commentLen;\n  }\n  throw new Error('word/document.xml not found inside DOCX');\n}\n\nlet text = '';\nif (meta.source_mode === 'docx') {\n  const xml = extractDocxXml(buf);\n  text = xml\n    .replace(/<w:p[\\s>]/g, '\\n<w:p ')\n    .replace(/<w:tab\\/>/g, '\\t')\n    .replace(/<[^>]+>/g, '')\n    .replace(/&amp;/g, '&')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"')\n    .replace(/&#39;/g, \"'\")\n    .replace(/\\n{3,}/g, '\\n\\n')\n    .trim();\n} else {\n  text = buf.toString('utf8').trim();\n}\n\nreturn [{\n  json: {\n    text,\n    filename: meta.filename,\n    category: meta.category,\n    doc_type: meta.doc_type,\n    uploaded_at: meta.uploaded_at\n  }\n}];"
      },
