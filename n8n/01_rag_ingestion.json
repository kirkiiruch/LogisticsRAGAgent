    {
      "parameters": {
        "jsCode": "const meta = $('Prepare Input').first().json;\nconst items = $input.all();\nlet text = '';\n\nif (meta.source_mode === 'csv') {\n  text = items.map((item) => {\n    const row = item.json || {};\n    return Object.entries(row)\n      .map(([k, v]) => `${k}: ${v}`)\n      .join(' | ');\n  }).filter(Boolean).join('\\n');\n} else {\n  const first = items[0] ? items[0].json : {};\n  text = String(first.text || first.data || meta.text || '').trim();\n}\n\nif (!text) {\n  throw new Error('Extracted document text is empty');\n}\n\nconst chunks_estimated = Math.max(1, Math.ceil(text.length / 680));\nreturn [{\n  json: {\n    text,\n    filename: meta.filename,\n    category: meta.category,\n    doc_type: meta.doc_type,\n    uploaded_at: meta.uploaded_at,\n    chunks_estimated\n  }\n}];"
      },
