# ==============================================================================
# LogisticsRAGAgent — Environment Variables Template
# Copy this file to .env for local on-premise Docker Compose, or configure
# these keys in Hugging Face Space Settings -> Variables and Secrets.
# NEVER commit a real .env file to Git!
# ==============================================================================

# --- n8n Core & Security ---
N8N_HOST=your-hf-space-subdomain.hf.space
N8N_PROTOCOL=https
WEBHOOK_URL=https://your-hf-space-subdomain.hf.space/
N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_CHAR_HEX_KEY
GENERIC_TIMEZONE=Europe/Bratislava
TZ=Europe/Bratislava

# --- Optional Webhook Bearer Token (used by n8n Check Bearer Auth & desktop_app) ---
# Leave empty to disable Bearer token validation during local testing.
WEBHOOK_BEARER_TOKEN=

# --- External PostgreSQL (Neon / Supabase for HF Spaces, or 'postgres' for On-Prem) ---
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=your-postgres-host.example.com
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n_user
DB_POSTGRESDB_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
DB_POSTGRESDB_SSL_ENABLED=true

# --- Qdrant Vector Store (Qdrant Cloud Free Tier or http://qdrant:6333 On-Premise) ---
QDRANT_URL=https://your-cluster-id.cloud.qdrant.io:6333
QDRANT_API_KEY=REPLACE_WITH_QDRANT_API_KEY
QDRANT_COLLECTION=logistics_docs

# --- Local Ollama (Cloudflare Quick Tunnel HTTPS URL or http://ollama:11434 On-Premise) ---
OLLAMA_BASE_URL=https://your-tunnel-id.trycloudflare.com
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
